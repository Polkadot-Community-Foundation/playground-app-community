{
  "name": "Polkadot Playground",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "playground:description": "A Web app for exploring & Modding example websites in the Polkadot ecosystem.",
  "playground:tag": "social",
  "playground:icon": "./assets/icon.png",
  "scripts": {
    "dev": "vite --host",
    "build:frontend": "tsc -b && vite build",
    "build:contracts": "cdm build",
    "typecheck": "tsc -b",
    "deploy": "cdm deploy -n paseo",
    "deploy:devnet": "cdm deploy -n devnet",
    "preview": "vite preview",
    "deploy:frontend": "MNEMONIC=$(node -e \"process.stdout.write(require(require('os').homedir()+'/.cdm/accounts.json').paseo.mnemonic)\") npx bulletin-deploy --env paseo-next-v2 ./dist playgroundtest.dot",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:contract": "vitest run --project=contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint:license": "./scripts/check-license-headers.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@ensdomains/content-hash": "^3.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/sixtyfour": "^5.2.8",
    "@parity/product-sdk-address": "^0.1.1",
    "@parity/product-sdk-cloud-storage": "^0.9.1",
    "@parity/product-sdk-chain-client": "^0.9.3",
    "@parity/product-sdk-contracts": "^0.10.1",
    "@parity/product-sdk-descriptors": "^0.8.0",
    "@parity/product-sdk-host": "^0.15.1",
    "@parity/product-sdk-keys": "^0.3.18",
    "@parity/product-sdk-logger": "^0.1.1",
    "@parity/product-sdk-signer": "^0.12.1",
    "@parity/product-sdk-utils": "^0.1.1",
    "@parity/result": "^0.2.0",
    "@polkadot-api/substrate-bindings": "^0.20.3",
    "@polkadot-labs/hdkd-helpers": "^0.0.30",
    "@scure/sr25519": "^2.2.0",
    "@sentry/react": "^10.53.0",
    "@types/dompurify": "^3.2.0",
    "dompurify": "^3.4.9",
    "lucide-react": "^0.469.0",
    "marked": "^17.0.6",
    "polkadot-api": "^2.1.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.1.1",
    "scale-ts": "^1.6.1",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@parity/bulletin-sdk": "^0.3.0",
    "@parity/host-api-test-sdk": "^0.9.2",
    "@parity/product-sdk-tx": "^0.4.1",
    "@playwright/test": "^1.60.0",
    "@polkadot-api/sdk-ink": "^0.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "bulletin-deploy": "0.9.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "_comment_overrides": "@polkadot-api/json-rpc-provider: upstream packaging bug workaround (mirrors product-sdk's monorepo). The former @novasamatech/host-api* pins are gone: the production host transport is now @parity/truapi (via @parity/product-sdk-host 0.15.1 and @parity/product-sdk-tx 0.4.1), not @novasamatech/host-api, so the single-transport-instance concern no longer attaches to host-api in the bundled graph. @novasamatech/host-api still resolves into the tree, but only through devDependencies that are never bundled into the frontend (the e2e @parity/host-api-test-sdk, and the bulletin-deploy CLI chain, which still pull a pre-truapi product-sdk-host), so it is left to resolve on its own.",
    "overrides": {
      "@polkadot-api/json-rpc-provider": "^0.2.0"
    }
  }
}
